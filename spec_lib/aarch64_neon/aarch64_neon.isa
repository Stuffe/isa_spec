[patterns]

; Optional pound symbol before immediates
pattern pd()
#

; Prefetch operations
pattern prf_op(f: Field)
%t({f})
%t[5:]

pattern prf_imm_5()
%_t[pd()|] %t:U5(immediate)
%t[4:]

pattern prf_imm_6()
%_t[pd()|] %t:U6(immediate)
%t[5:]

pattern prf_5(f: Field)
%t[prf_op({f}) | prf_imm_5()]
%t[4:]

pattern prf_6(f: Field)
%t[prf_op({f}) | prf_imm_6()]
%t[5:]

[instructions]

; Generated from https://developer.arm.com/documentation/ddi0602/2025-06/Base-Instructions/ABS--Absolute-value-
abs %d(r32), %n(r32)
0 1 0 11010110 00000 001000 %n[4:] %d[4:]
# Absolute value

abs %d(r64), %n(r64)
1 1 0 11010110 00000 001000 %n[4:] %d[4:]
# Absolute value


; Generated from https://developer.arm.com/documentation/ddi0602/2025-06/Base-Instructions/ADCS--Add-with-carry--setting-flags-
adcs %d(r32), %n(r32), %m(r32)
0 0 1 11010000 %m[4:] 000000 %n[4:] %d[4:]
# Add with carry, setting flags

adcs %d(r64), %n(r64), %m(r64)
1 0 1 11010000 %m[4:] 000000 %n[4:] %d[4:]
# Add with carry, setting flags


; Generated from https://developer.arm.com/documentation/ddi0602/2025-06/Base-Instructions/ADC--Add-with-carry-
adc %d(r32), %n(r32), %m(r32)
0 0 0 11010000 %m[4:] 000000 %n[4:] %d[4:]
# Add with carry

adc %d(r64), %n(r64), %m(r64)
1 0 0 11010000 %m[4:] 000000 %n[4:] %d[4:]
# Add with carry


; Generated from https://developer.arm.com/documentation/ddi0602/2025-06/Base-Instructions/ADDG--Add-with-tag-
addg %d(rsp64) , %n(rsp64) , %_i10[pd()|] %i10:U10(immediate) , %_i4[pd()|] %i4:U4(immediate)
assert(%i10 % 0x10 == 0, "%i10 must be a multiple of 16")
1 0 0 1000110 %i10[9:4] 00 %i4[3:] %n[4:] %d[4:]
# Add with tag


; Generated from https://developer.arm.com/documentation/ddi0602/2025-06/Base-Instructions/CMN--extended-register---Compare-negative--extended-register---an-alias-of-ADDS--extended-register--
cmn wsp, %m(r32)
0 0 1 01011 00 1 %m[4:] 010 000 11111 11111
# Compare negative (extended register)

cmn wsp, %m(r32), lsl
0 0 1 01011 00 1 %m[4:] 010 000 11111 11111
# Compare negative (extended register)

cmn wsp, %m(r32), lsl %_sh[pd()|] %sh:U3(immediate)
0 0 1 01011 00 1 %m[4:] 010 %sh[2:] 11111 11111
# Compare negative (extended register)

cmn %n(rsp32) , %m(r32), %ext(ext)
0 0 1 01011 00 1 %m[4:] %ext[2:] 000 %n[4:] 11111
# Compare negative (extended register)

cmn %n(rsp32) , %m(r32), %ext(ext) %_sh[pd()|] %sh:U3(immediate)
0 0 1 01011 00 1 %m[4:] %ext[2:] %sh[2:] %n[4:] 11111
# Compare negative (extended register)

cmn sp, %m(r64)
1 0 1 01011 00 1 %m[4:] 011 000 11111 11111
# Compare negative (extended register)

cmn sp, %m(r64), lsl
1 0 1 01011 00 1 %m[4:] 011 000 11111 11111
# Compare negative (extended register)

cmn sp, %m(r64), lsl %_sh[pd()|] %sh:U3(immediate)
1 0 1 01011 00 1 %m[4:] 011 %sh[2:] 11111 11111
# Compare negative (extended register)

cmn %n(rsp64) , %m(r32), %ext(ext32)
1 0 1 01011 00 1 %m[4:] %ext[2:] 000 %n[4:] 11111
# Compare negative (extended register)

cmn %n(rsp64) , %m(r64), %ext(ext64)
1 0 1 01011 00 1 %m[4:] %ext[2:] 000 %n[4:] 11111
# Compare negative (extended register)

cmn %n(rsp32) , %m(r32), %ext(ext32) %_sh[pd()|] %sh:U3(immediate)
1 0 1 01011 00 1 %m[4:] %ext[2:] %sh[2:] %n[4:] 11111
# Compare negative (extended register)

cmn %n(rsp32) , %m(r64), %ext(ext64) %_sh[pd()|] %sh:U3(immediate)
1 0 1 01011 00 1 %m[4:] %ext[2:] %sh[2:] %n[4:] 11111
# Compare negative (extended register)


; Generated from https://developer.arm.com/documentation/ddi0602/2025-06/Base-Instructions/CMN--immediate---Compare-negative--immediate---an-alias-of-ADDS--immediate--
cmn %n(rsp32), %_i12[pd()|] %i12:U12(immediate)
0 0 1 100010 0 %i12[11:] 11111 11111
# Compare negative (immediate)

cmn %n(rsp32), %_i12[pd()|] %i12:U12(immediate), lsl %sh:U4(immediate)
assert(%sh % 12 == 0, "")
0 0 1 100010 %sh[2:2] %i12[11:] 11111 11111
# Compare negative (immediate)

cmn %n(rsp64), %_i12[pd()|] %i12:U12(immediate)
1 0 1 100010 0 %i12[11:] 11111 11111
# Compare negative (immediate)

cmn %n(rsp64), %_i12[pd()|] %i12:U12(immediate), lsl %sh:U4(immediate)
assert(%sh % 12 == 0, "")
1 0 1 100010 %sh[2:2] %i12[11:] 11111 11111
# Compare negative (immediate)


; Generated from https://developer.arm.com/documentation/ddi0602/2025-06/Base-Instructions/CMN--shifted-register---Compare-negative--shifted-register---an-alias-of-ADDS--shifted-register--
cmn %n(r32), %m(r32)
0 0 1 01011 00 0 %m[4:] 000000 %n[4:] 11111
# Compare negative (shifted register)

cmn %n(r32), %m(r32), %ext(shf) %_sh[pd()|] %sh:U5(immediate)
0 0 1 01011 %ext[1:] 0 %m[4:] %sh[5:] %n[4:] 11111
# Compare negative (shifted register)

cmn %n(r64), %m(r64)
1 0 1 01011 00 0 %m[4:] 000000 %n[4:] 11111
# Compare negative (shifted register)

cmn %n(r64), %m(r64), %ext(shf) %_sh[pd()|] %sh:U6(immediate)
1 0 1 01011 %ext[1:] 0 %m[4:] %sh[5:] %n[4:] 11111
# Compare negative (shifted register)


