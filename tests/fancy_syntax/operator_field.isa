[settings]
endianness = little

[fields]
register
r0 000
r1 001
r2 010
r3 011
r4 100
r5 101
r6 110
r7 111

[patterns]

pattern p0()
+
000

pattern p1()
-
001

pattern p2()
&
010

pattern p3()
|
011

pattern p6()
&&
110

pattern p7()
||
111

pattern operator()
%p[p0() | p1() | p2() | p3() | p6() | p7()]
%p

[instructions]
%t(register) = %a(register) %o[operator()] %b(register)
0ooo 0ttt 0aaa 0bbb
