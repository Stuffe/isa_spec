tst %n(r32), %_i[pd()|] %i:U32(immediate)
%imm = (%i << 32) | %i
%rot = trailing_zeros(%imm & (%imm + 1)) & 0x3F
%norm = (%imm >> %rot) | (%imm << (64 - %rot))
%zeroes = 63 - log2(%norm)
%ones = trailing_zeros(%norm ^ -1)
%size = %zeroes + %ones
%N = %size >> 6
%imms = ((0 - (%size << 1)) | (%ones - 1)) & 0x3F
%immr = (0 - %rot) & (%size - 1)
assert(%i != 0 && %i != -1, "Bit mask immediate not encodeable")
assert(((%imm >> %size) | (%imm << (64 - %size))) == %imm, "Bit mask immediate not encodeable")
assert(%N == 0, "%N must be 0 for 32-bit variant")
